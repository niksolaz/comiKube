# Variabili d'ambiente — esempio.
# Copia questo file in `.env` e adatta i valori per l'ambiente locale.
# `.env` NON va mai committato (già escluso da .gitignore).

# Porta HTTP dell'API NestJS (letta in apps/api/src/main.ts)
PORT=3000

# In seguito (fase motore AI / pagamenti / code):
# - chiave del provider AI (es. provider_api_key=...)
# - URL Redis (es. REDIS_URL=redis://localhost:6379)
# - credenziali database PostgreSQL